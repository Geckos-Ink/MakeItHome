    "widgets.my_widgets.description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدام «عناصر واجهتي» يمكنك إنشاء عناصر واجهة مخصصة تشير إلى مواقعك المفضلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Meine Widgets“ können Sie eigene Widgets erstellen, die auf Ihre bevorzugten Websites verweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With My Widgets you can create your own custom widgets that point to your favorite website."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Mis widgets puedes crear widgets personalizados que apunten a tus sitios web favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Mes widgets, vous pouvez créer vos propres widgets personnalisés pointant vers vos sites web préférés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे विजेट की मदद से आप अपने पसंदीदा वेबसाइटों की ओर ले जाने वाले कस्टम विजेट बना सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con I miei widget puoi creare widget personalizzati che rimandano ai tuoi siti web preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイウィジェットでは、お気に入りのWebサイトを開く独自のカスタムウィジェットを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 위젯을 사용하면 즐겨 찾는 웹사이트로 연결되는 사용자 지정 위젯을 만들 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Os meus widgets pode criar widgets personalizados que apontam para os seus sites favoritos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С помощью «Моих виджетов» можно создавать собственные виджеты со ссылками на любимые сайты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За допомогою «Моїх віджетів» можна створювати власні віджети з посиланнями на улюблені вебсайти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“我的小组件”，您可以创建指向喜爱网站的自定义小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「我的小工具」，您可以建立連結至喜愛網站的自訂小工具。"
          }
        }
      }
    },
