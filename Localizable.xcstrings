    "MakeItHome can use Apple Events to get and make some automations for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ MakeItHome استخدام أحداث Apple للحصول على بعض المعلومات وتنفيذ عمليات تلقائية نيابةً عنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome kann Apple Events verwenden, um Informationen abzurufen und einige Automatisierungen für Sie auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome can use Apple Events to get and make some automations for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome puede usar Apple Events para obtener información y realizar algunas automatizaciones por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome peut utiliser Apple Events pour obtenir des informations et effectuer certaines automatisations pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome जानकारी प्राप्त करने और आपके लिए कुछ ऑटोमेशन करने हेतु Apple Events का उपयोग कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome può usare Apple Events per ottenere informazioni ed eseguire alcune automazioni per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHomeはApple Eventsを使用して情報を取得し、いくつかの操作を自動化できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome은 Apple Events를 사용하여 정보를 가져오고 일부 작업을 자동화할 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O MakeItHome pode utilizar Apple Events para obter informações e executar algumas automatizações por si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome может использовать Apple Events для получения информации и выполнения некоторых автоматических действий."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome може використовувати Apple Events для отримання інформації та виконання деяких автоматизованих дій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome 可以使用 Apple Events 获取信息并为您执行一些自动化操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MakeItHome 可以使用 Apple Events 取得資訊並為您執行一些自動化操作。"
          }
        }
      }
    },
