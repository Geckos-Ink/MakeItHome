          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि पहली पॉपअप विंडो अनदेखी की गई, तो MakeItHome 30 सेकंड बाद फिर पूछेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
