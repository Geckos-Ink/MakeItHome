    "widgets.extensions.permission_ignored": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجاهل النافذة المنبثقة. سيطلب MakeItHome الإذن مرة أخرى بعد 30 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pop-up ignoriert. MakeItHome fragt nach 30 Sekunden erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Popup ignored. MakeItHome will ask again after 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana emergente ignorada. MakeItHome volverá a preguntar después de 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre ignorée. MakeItHome redemandera l’autorisation après 30 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉपअप अनदेखी की गई। MakeItHome 30 सेकंड बाद फिर पूछेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Popup ignorato. MakeItHome chiederà nuovamente il permesso dopo 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップアップが無視されました。MakeItHomeは30秒後に再度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팝업을 무시했습니다. MakeItHome이 30초 후 다시 요청합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela ignorada. O MakeItHome voltará a pedir após 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всплывающее окно проигнорировано. MakeItHome повторит запрос через 30 секунд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спливне вікно проігноровано. MakeItHome повторить запит через 30 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹窗已忽略。MakeItHome 将在 30 秒后再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出式視窗已忽略。MakeItHome 將在 30 秒後再次詢問。"
          }
        }
      }
    },
    "widgets.extensions.permissions.description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مراجعة كل امتداد معروف ومنح الوصول أو إلغاؤه في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jede bekannte Erweiterung überprüfen und den Zugriff jederzeit gewähren oder widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can review every known extension and grant or revoke access at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes revisar cada extensión conocida y conceder o revocar el acceso en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter chaque extension connue et accorder ou révoquer son accès à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हर ज्ञात एक्सटेंशन की समीक्षा कर सकते हैं और किसी भी समय पहुँच दे या वापस ले सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi controllare ogni estensione conosciuta e concedere o revocare l’accesso in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既知の各拡張機能を確認し、いつでもアクセスを許可または取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 모든 확장 프로그램을 검토하고 언제든지 접근 권한을 허용하거나 취소할 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode rever todas as extensões conhecidas e conceder ou revogar o acesso a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете просмотреть все известные расширения и в любой момент предоставить или отозвать доступ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете переглянути кожне відоме розширення та будь-коли надати або відкликати доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以查看每个已知扩展，并随时授予或撤销访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以檢視每個已知擴充功能，並隨時授予或撤銷存取權限。"
          }
        }
      }
    },
    "widgets.extensions.permissions.retry": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تم تجاهل النافذة المنبثقة الأولى، فسيطلب MakeItHome الإذن مرة أخرى بعد 30 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
