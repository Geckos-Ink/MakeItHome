    "And click to '+' selecting MakeItHome in your Applications folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وانقر فوق \"+\" لتحديد MakeItHome في مجلد التطبيقات لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf \"+\" und wählen Sie MakeItHome in Ihrem Anwendungsordner aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And click to '+' selecting MakeItHome in your Applications folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y haz clic en '+' seleccionando MakeItHome en tu carpeta de Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et cliquez sur '+' en sélectionnant MakeItHome dans votre dossier Applications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और अपने एप्लिकेशन फ़ोल्डर में MakeItHome का चयन करके '+' पर क्लिक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E fate clic su '+' selezionando MakeItHome nella cartella Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そして、アプリケーションフォルダ内のMakeItHomeを選択し、「+」をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리고 '+'를 클릭해 애플리케이션 폴더에서 MakeItHome을 선택합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "E clique em \"+\" para selecionar MakeItHome na pasta Aplicações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И щелкните на \"+\", выбрав MakeItHome в папке Applications."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "І натисніть на \"+\", вибравши MakeItHome у вашій папці \"Програми\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后点击 \"+\"，选择应用程序文件夹中的 MakeItHome。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然后点击 \"+\"，选择应用程序文件夹中的 MakeItHome。"
          }
        }
      }
    },
