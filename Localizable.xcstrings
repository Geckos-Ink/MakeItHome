    "widgets.my_widgets.cookies": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض المواقع من خلال iframe (وقد لا تعمل خدمات مثل Google من دون وكيل)، ولا تُحفظ ملفات تعريف الارتباط بين الجلسات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites werden in einem iframe angezeigt (Dienste wie Google funktionieren ohne Proxy möglicherweise nicht), und Cookies werden nicht sitzungsübergreifend gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites are shown through an iframe (services like Google used to not work without a proxy) and cookies are not saved through the sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sitios web se muestran mediante un iframe (servicios como Google pueden no funcionar sin un proxy) y las cookies no se guardan entre sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sites web sont affichés dans une iframe (des services comme Google peuvent ne pas fonctionner sans proxy) et les cookies ne sont pas conservés entre les sessions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेबसाइटें iframe के माध्यम से दिखाई जाती हैं (Google जैसी सेवाएँ प्रॉक्सी के बिना काम नहीं कर सकतीं) और कुकीज़ सत्रों के बीच सहेजी नहीं जातीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I siti web vengono mostrati tramite un iframe (servizi come Google potrebbero non funzionare senza un proxy) e i cookie non vengono salvati tra le sessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webサイトはiframeで表示されます（Googleなどのサービスはプロキシなしでは動作しない場合があります）。Cookieはセッション間で保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트는 iframe으로 표시됩니다(Google 같은 서비스는 프록시 없이는 작동하지 않을 수 있음). 쿠키는 세션 간에 저장되지 않습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sites são apresentados através de um iframe (serviços como o Google podem não funcionar sem um proxy) e os cookies não são guardados entre sessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты отображаются через iframe (такие сервисы, как Google, могут не работать без прокси), а файлы cookie не сохраняются между сеансами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вебсайти відображаються через iframe (такі служби, як Google, можуть не працювати без проксі), а файли cookie не зберігаються між сеансами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站通过 iframe 显示（Google 等服务在没有代理时可能无法使用），Cookie 不会在不同会话间保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站透過 iframe 顯示（Google 等服務在沒有代理伺服器時可能無法使用），Cookie 不會在不同工作階段之間儲存。"
          }
        }
      }
    },
