        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se ignoró la primera ventana emergente, MakeItHome vuelve a preguntar después de 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
