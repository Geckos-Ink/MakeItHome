          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 감지된 확장 프로그램이 없습니다. 확장 프로그램을 한 번 연 다음 이 목록을 새로고침하세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi detetada nenhuma extensão. Abra a extensão uma vez e depois atualize esta lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
