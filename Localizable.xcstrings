        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A causa dell’uso della registrazione dello schermo, le notifiche sono disabilitate per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録を使用するため、通知はデフォルトで無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 녹화를 사용하므로 알림은 기본적으로 비활성화되어 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por predefinição, devido à utilização da gravação do ecrã, as notificações estão desativadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию уведомления отключены из-за использования записи экрана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням сповіщення вимкнені через використання запису екрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于使用了屏幕录制，通知默认处于禁用状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於使用了螢幕錄製，通知預設為停用。"
          }
        }
      }
    },
    "widgets.guides.notifications.enable": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تمكينها بالانتقال إلى الإعدادات > إعدادات الإشعارات وتفعيل «السماح بالإشعارات عند عكس الشاشة أو مشاركتها»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können sie unter Einstellungen > Mitteilungseinstellungen aktivieren, indem Sie „Mitteilungen beim Spiegeln oder Teilen des Bildschirms erlauben“ einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can enable it going in Settings > Notification settings and enabling \"Allow notifications when mirroring or sharing the display\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes activarlas en Ajustes > Ajustes de notificaciones, habilitando «Permitir notificaciones al duplicar o compartir la pantalla»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez les activer dans Réglages > Réglages des notifications en activant « Autoriser les notifications lors de la recopie ou du partage de l’écran »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप सेटिंग्स > सूचना सेटिंग्स में जाकर “स्क्रीन मिरर या साझा करते समय सूचनाओं की अनुमति दें” को सक्षम करके इन्हें चालू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi abilitarle andando in Impostazioni > Impostazioni notifiche e attivando “Consenti notifiche durante la duplicazione o la condivisione dello schermo”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > 通知設定で「ディスプレイのミラーリングまたは共有中に通知を許可」を有効にすると、通知を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 알림 설정에서 “디스플레이 미러링 또는 공유 중 알림 허용”을 활성화하면 알림을 켤 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ativá-las em Definições > Definições de notificações, ativando «Permitir notificações ao espelhar ou partilhar o ecrã»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их можно включить в разделе Настройки > Настройки уведомлений, активировав «Разрешить уведомления при дублировании или общем доступе к экрану»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їх можна ввімкнути в Налаштування > Налаштування сповіщень, активувавши «Дозволити сповіщення під час дублювання або поширення екрана»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以前往“设置”>“通知设置”，启用“镜像或共享显示器时允许通知”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以前往「設定」>「通知設定」，啟用「鏡像或共享顯示器時允許通知」。"
          }
        }
      }
    },
