    "- Retrieve your current desktop background for using it as overscreen background": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "- استرداد خلفية سطح المكتب الحالية لاستخدامها كخلفية للشاشة الممتدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "- Aktuellen Desktophintergrund abrufen, um ihn als Overscreen-Hintergrund zu verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "- Retrieve your current desktop background for using it as overscreen background"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "- Recuperar el fondo de escritorio actual para usarlo como fondo de la pantalla extendida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Récupérer votre fond d’écran actuel pour l’utiliser comme arrière-plan de l’écran étendu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "- विस्तारित स्क्रीन की पृष्ठभूमि के रूप में उपयोग करने के लिए अपना वर्तमान डेस्कटॉप वॉलपेपर प्राप्त करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "- Recupera lo sfondo attuale della scrivania per usarlo come sfondo dell’overscreen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "- 現在のデスクトップ背景を取得して、オーバースクリーンの背景として使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "- 현재 데스크탑 배경을 가져와 오버스크린 배경으로 사용"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "- Obter o fundo atual do ambiente de trabalho para o utilizar como fundo do ecrã expandido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "- Получить текущий фон рабочего стола для использования в качестве фона расширенного экрана"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "- Отримати поточне тло робочого столу для використання як тло розширеного екрана"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- 获取当前桌面背景，用作扩展屏幕背景"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "- 取得目前的桌面背景，用作延伸螢幕背景"
          }
        }
      }
    },
