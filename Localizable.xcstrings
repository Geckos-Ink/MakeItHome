    "widgets.guides.calendar.description": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح التقويم حاليًا عرض الأحداث ومعاينتها بالنقر عليها أو تعديلها بسرعة بالنقر بزر الفأرة الأيمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit können im Kalender Ereignisse angezeigt, durch Anklicken in der Vorschau geöffnet oder per Rechtsklick schnell bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this moment, the calendar provides a way to show events, their previews clicking on them or to rapidly edit them with a right click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por el momento, el calendario permite mostrar eventos, ver su vista previa al hacer clic en ellos o editarlos rápidamente con un clic derecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le moment, le calendrier permet d’afficher les événements, d’en voir un aperçu en cliquant dessus ou de les modifier rapidement avec un clic droit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिलहाल कैलेंडर घटनाएँ दिखाने, उन पर क्लिक करके पूर्वावलोकन देखने या दायाँ-क्लिक करके जल्दी संपादित करने की सुविधा देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento, il calendario consente di mostrare gli eventi, visualizzarne l’anteprima facendovi clic o modificarli rapidamente con un clic destro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、カレンダーではイベントの表示、クリックによるプレビュー、右クリックによる簡単な編集ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 캘린더에서는 이벤트를 표시하고 클릭해 미리 보거나 마우스 오른쪽 버튼으로 빠르게 편집할 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento, o calendário permite mostrar eventos, ver a respetiva pré-visualização ao clicar neles ou editá-los rapidamente com um clique direito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас календарь позволяет показывать события, открывать их предварительный просмотр нажатием или быстро редактировать их правой кнопкой мыши."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі календар дає змогу показувати події, відкривати їх попередній перегляд натисканням або швидко редагувати їх правою кнопкою миші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前，日历可以显示事件，点击事件可查看预览，右键点击可快速编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前，行事曆可以顯示事件，按一下事件可查看預覽，以滑鼠右鍵按一下可快速編輯。"
          }
        }
      }
    },
    "widgets.guides.calendar.title": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيفية عمل التقويم"
