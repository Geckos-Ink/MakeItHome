    "Thank you for tried Gecko's Ink MakeItHome for 30 days. But now it's your choice!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لتجربة MakeItHome من Gecko's Ink لمدة 30 يومًا. والآن القرار لك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank, dass Sie Gecko's Ink MakeItHome 30 Tage lang getestet haben. Jetzt haben Sie die Wahl!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for tried Gecko's Ink MakeItHome for 30 days. But now it's your choice!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por probar MakeItHome de Gecko's Ink durante 30 días. ¡Ahora tú decides!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d’avoir essayé MakeItHome de Gecko's Ink pendant 30 jours. À vous de choisir maintenant !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecko's Ink MakeItHome को 30 दिनों तक आज़माने के लिए धन्यवाद। अब फैसला आपका है!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver provato MakeItHome di Gecko's Ink per 30 giorni. Ora la scelta è tua!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecko's Ink MakeItHomeを30日間お試しいただき、ありがとうございました。あとはあなた次第です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecko's Ink MakeItHome을 30일 동안 사용해 주셔서 감사합니다. 이제 선택은 여러분의 몫입니다!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por experimentar o MakeItHome da Gecko's Ink durante 30 dias. Agora a escolha é sua!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что пользовались Gecko's Ink MakeItHome в течение 30 дней. Теперь выбор за вами!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо, що випробовували Gecko's Ink MakeItHome протягом 30 днів. Тепер вибір за вами!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您试用 Gecko's Ink MakeItHome 30 天。现在由您决定！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝您試用 Gecko's Ink MakeItHome 30 天。現在由您決定！"
          }
        }
      }
    },
