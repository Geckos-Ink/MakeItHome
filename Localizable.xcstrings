    "widgets.settings.introduction.feedback": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال العديد من الميزات مفقودة حاليًا، بما في ذلك ترجمات عناصر الواجهة، لكننا نقدر ملاحظاتك حول تجربتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit fehlen noch viele Funktionen, darunter die Übersetzungen der Widgets. Wir freuen uns jedoch über Ihr Feedback zu Ihrer Erfahrung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this moment are missing many features including widgets' translations, but we appreciate your feedback about your experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este momento todavía faltan muchas funciones, incluidas las traducciones de los widgets, pero agradecemos tus comentarios sobre la experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nombreuses fonctionnalités manquent encore actuellement, notamment les traductions des widgets, mais vos commentaires sur votre expérience nous sont précieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय विजेट अनुवाद सहित कई सुविधाएँ अभी उपलब्ध नहीं हैं, लेकिन हम आपके अनुभव पर आपकी प्रतिक्रिया की सराहना करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento mancano ancora molte funzionalità, comprese le traduzioni dei widget, ma apprezziamo il tuo feedback sull’esperienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在はウィジェットの翻訳を含む多くの機能がまだ不足していますが、ご利用体験についてのフィードバックをお待ちしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위젯 번역을 비롯한 여러 기능이 아직 빠져 있지만, 사용 경험에 대한 의견을 보내 주시면 감사하겠습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento ainda faltam muitas funcionalidades, incluindo as traduções dos widgets, mas agradecemos os seus comentários sobre a experiência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас ещё отсутствуют многие функции, включая переводы виджетов, но мы будем рады вашему отзыву о работе с приложением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі ще бракує багатьох функцій, зокрема перекладів віджетів, але ми цінуємо ваш відгук про роботу з програмою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
